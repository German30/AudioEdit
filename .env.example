# Copy to .env and adjust. Consumed by compose.yaml.

# Host port the frontend container (nginx on 4200) is published on.
WEB_PORT=4200

# Full origin of the Auralis API — the frontend proxies /api, /oauth2 and
# /actuator/health to it. The SPA is built with a relative base ("/api/v1"),
# so the browser only ever talks to this container.
#   local backend on the Docker host : http://host.docker.internal:8080
#   real deployment                  : https://api.your-domain.example
BACKEND_ORIGIN=http://host.docker.internal:8080

# DNS resolver nginx uses to look up BACKEND_ORIGIN's host at request time.
# 127.0.0.11 is Docker's embedded DNS; override for Kubernetes / bare metal.
RESOLVER=127.0.0.11

# --- the BACKEND deployment must be configured to trust this frontend --------
# On the Auralis API set:
#   FRONTEND_REDIRECT_URI = http://localhost:4200/oauth/callback   (this app's URL)
#   CORS_ORIGINS          = http://localhost:4200
#   SERVER_FORWARD_HEADERS_STRATEGY = framework   (so it honours X-Forwarded-*)
# and, if you want the email/name dev-login instead of real OAuth apps:
#   AURALIS_AUTH_DEV_LOGIN_ENABLED = true
